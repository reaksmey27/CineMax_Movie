# TMDB: set either the API key or the read-access token.
# Get credentials from https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key
# Optional alternative to VITE_TMDB_API_KEY (takes precedence if both are set):
# VITE_TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Optional; required to enable Firebase App Check with reCAPTCHA v3:
# VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_v3_site_key
