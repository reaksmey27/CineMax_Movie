rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /playbackReports/{userId}/reports/{reportId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['movieId', 'movieTitle', 'server', 'issue', 'createdAt'])
        && request.resource.data.movieId is int && request.resource.data.movieId > 0
        && request.resource.data.movieTitle is string && request.resource.data.movieTitle.size() <= 300
        && request.resource.data.server in ['Server 1', 'Server 2', 'Server 3', 'Server 4']
        && request.resource.data.issue in ['not-loading', 'no-sound', 'wrong-movie']
        && reportId == string(request.resource.data.movieId) + '-'
          + {'Server 1': '1', 'Server 2': '2', 'Server 3': '3', 'Server 4': '4'}[request.resource.data.server]
          + '-' + request.resource.data.issue
        && request.resource.data.createdAt == request.time;
    }
    match /favorites/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /watchlists/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /watchHistory/{userId}/movies/{movieId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /notifications/{userId}/history/{notificationId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
